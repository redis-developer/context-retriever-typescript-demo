# Copy to .env and fill in. Never commit .env.
#
# Every command validates only the variables it needs, and reports all missing
# ones at once. Run `npm run doctor` to see what is configured.

# --- Control plane: administrative REST -------------------------------------
# Base URL of the Context Retriever admin API.
CONTEXT_RETRIEVER_SERVER_URL=http://localhost:8080
# An admin API key. The local stack writes the first one to
# /opt/initialAdminKey.txt in the admin pod; `make dev-local-key` prints it.
# Never ship this to an agent.
CONTEXT_RETRIEVER_API_KEY_AUTH=

# --- Data plane: MCP --------------------------------------------------------
# Both values are printed by `npm run provision`. The agent key is returned
# exactly once, so store it when you see it.
CONTEXT_RETRIEVER_MCP_URL=http://localhost:8081/mcp
CONTEXT_RETRIEVER_AGENT_KEY=

# --- The surface's data source ----------------------------------------------
# How the Context Retriever *service* reaches the data Redis, which is not how
# you reach it. Seeding runs wherever you run it and uses DEMO_REDIS_URL below;
# the surface is configured with an address the service resolves itself. In a
# containerised deployment `localhost:6380` on your machine is not
# `localhost:6380` inside that container, and a surface configured with the
# wrong one provisions successfully and then indexes nothing.
# For the local stack this is the container name and its internal port.
DEMO_DATA_SOURCE_ADDR=redis-data:6379
DEMO_DATA_SOURCE_USERNAME=
DEMO_DATA_SOURCE_PASSWORD=
DEMO_DATA_SOURCE_TLS=false

# --- Seeding ----------------------------------------------------------------
# The Redis holding the demo records. Written to directly, so that schema
# inference has a keyspace to sample.
DEMO_REDIS_URL=redis://localhost:6380

# --- The demo ---------------------------------------------------------------
DEMO_DOMAIN=retail-banking
# The generator is deterministic: the same seed yields identical records.
DEMO_SEED=1
# The signed-in customer. In production this comes from a validated JWT; here
# it comes from configuration, and the demo authenticates nobody.
DEMO_CUSTOMER_ID=CUST001
DEMO_CUSTOMER_NAME=Aisha Khan

# --- Agent ------------------------------------------------------------------
OPENAI_API_KEY=
DEMO_CHAT_MODEL=gpt-5.6-luna
DEMO_AGENT_PORT=3100

# --- SQL baseline -----------------------------------------------------------
# Only `npm run sql:seed` and `npm run compare` read these. Nothing else in the
# repository needs Postgres.
#
# Two URLs for what looks like one value, for the same reason the two Redis
# settings above are separate: the privileges needed to create a table are not
# the privileges the thing being measured should hold. The loader creates the
# schema and the reader role; the comparison's SQL arm logs in as that role and
# can do nothing but read. Pointing both at the same URL would quietly hand the
# baseline write access and make its read-only claim untrue.
#
# `sql:seed` creates the role and password named in the reader URL, so change
# them there rather than in two places.
DEMO_PG_ADMIN_URL=postgresql://demo:demo@localhost:5433/demo
DEMO_PG_READER_URL=postgresql://demo_ro:demo_ro@localhost:5433/demo
# A read-only role does not protect availability: an unbounded scan is a read.
DEMO_PG_STATEMENT_TIMEOUT_MS=5000
