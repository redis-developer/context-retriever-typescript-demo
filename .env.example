# Copy to .env and fill in. Never commit .env.
#
# Every command validates only the variables it needs, and reports all missing
# ones at once. Run `npm run doctor` to see what is configured.

# --- Control plane: administrative REST -------------------------------------
# Base URL of the Context Retriever admin API.
CONTEXT_RETRIEVER_SERVER_URL=http://localhost:8080
# An admin API key. The local stack writes the first one to
# /opt/initialAdminKey.txt in the admin pod; `make dev-local-key` prints it.
# Never ship this to an agent.
CONTEXT_RETRIEVER_API_KEY_AUTH=

# --- Data plane: MCP --------------------------------------------------------
# Both values are printed by `npm run provision`. The agent key is returned
# exactly once, so store it when you see it.
CONTEXT_RETRIEVER_MCP_URL=http://localhost:8081/mcp
CONTEXT_RETRIEVER_AGENT_KEY=

# --- Seeding ----------------------------------------------------------------
# The Redis holding the demo records. Written to directly, so that schema
# inference has a keyspace to sample.
DEMO_REDIS_URL=redis://localhost:6380

# --- The demo ---------------------------------------------------------------
DEMO_DOMAIN=retail-banking
# The generator is deterministic: the same seed yields identical records.
DEMO_SEED=1
# The signed-in customer. In production this comes from a validated JWT; here
# it comes from configuration, and the demo authenticates nobody.
DEMO_CUSTOMER_ID=CUST001
DEMO_CUSTOMER_NAME=Aisha Khan

# --- Agent ------------------------------------------------------------------
OPENAI_API_KEY=
DEMO_CHAT_MODEL=gpt-5.6-luna
DEMO_AGENT_PORT=3100
